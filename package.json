{
  "name": "vue-pcdemo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src-electron/main.ts",
  "engines": {
    "node": "^20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "electron:build": "vite build --mode electron && electron-builder",
    "type-check": "vue-tsc --build",
    "spec-check": "node scripts/check-frontend-spec.mjs",
    "lint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/",
    "prepare": "husky install",
    "lint-staged": "lint-staged"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "eslint --fix"
    ]
  },
  "build": {
    "productName": "yzcTool",
    "appId": "dyy.dongyuanwai",
    "copyright": "dyy.dongyuanwai © 2024",
    "compression": "maximum",
    "asar": true,
    "directories": {
      "output": "./release"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": true,
      "deleteAppDataOnUninstall": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "yzcTool"
    },
    "win": {
      "icon": "./public/icon-256.png",
      "artifactName": "${productName}-v${version}-${platform}-setup.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ]
    },
    "mac": {
      "icon": "./public/icon-256.png",
      "artifactName": "${productName}-v${version}-${platform}-setup.${ext}"
    },
    "linux": {
      "icon": "./public/icon-256.png",
      "artifactName": "${productName}-v${version}-${platform}-setup.${ext}"
    }
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@splinetool/runtime": "^1.12.49",
    "@vue-office/docx": "^1.6.3",
    "@vue-office/excel": "^1.7.14",
    "@vue-office/pdf": "^2.0.10",
    "axios": "^1.13.2",
    "echarts": "^6.0.0",
    "electron-devtools-installer": "^4.0.0",
    "element-plus": "^2.13.0",
    "flv.js": "^1.6.2",
    "hls.js": "^1.6.15",
    "nprogress": "^0.2.0",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "three": "^0.182.0",
    "vite-plugin-electron": "^0.29.0",
    "vue": "^3.5.25",
    "vue-demi": "^0.14.10",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.3",
    "@types/mockjs": "^1.0.10",
    "@types/node": "^25.0.3",
    "@types/nprogress": "^0.2.3",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.8.1",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "eslint": "^9.39.1",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-vue": "~10.6.2",
    "husky": "^8.0.0",
    "jiti": "^2.6.1",
    "lint-staged": "^16.2.7",
    "mockjs": "^1.1.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "3.7.4",
    "sass": "^1.97.1",
    "typescript": "~5.9.0",
    "unplugin-auto-import": "^20.3.0",
    "unplugin-vue-components": "^30.0.0",
    "vite": "^7.3.0",
    "vite-plugin-mock": "^3.0.2",
    "vite-plugin-svg-icons": "^2.0.1",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vue-tsc": "^3.1.5"
  }
}
